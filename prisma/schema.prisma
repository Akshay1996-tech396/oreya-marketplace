generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  password                String
  phone                   String?
  role                    Role                     @default(CUSTOMER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  username                String?                  @unique
  emailVerifiedAt         DateTime?
  adminLoginOtp           AdminLoginOtp?
  bookings                Booking[]
  cart                    Cart?
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  orders                  Order[]
  payments                Payment[]
  restaurantReservations  RestaurantReservation[]
  reviews                 Review[]
  vendorProfile           VendorProfile?

  @@index([role])
  @@index([emailVerifiedAt])
  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model AdminLoginOtp {
  id         String   @id @default(cuid())
  userId     String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_login_otps")
}

model VendorProfile {
  id                       String                  @id @default(cuid())
  userId                   String                  @unique
  businessName             String
  slug                     String                  @unique
  description              String?                 @db.VarChar(1000)
  phone                    String?
  address                  String?
  city                     String?
  country                  String?
  status                   VendorStatus            @default(PENDING)
  commissionRate           Decimal                 @default(0) @db.Decimal(5, 2)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  addressLine1             String?
  addressLine2             String?
  branchName               String?
  brandName                String?
  companyName              String?
  licenseExpiry            DateTime?
  licenseFile              String?
  mobileCountryCode        String?
  residentialCountryCode   String?
  residentialPhone         String?
  state                    String?
  termsAccepted            Boolean                 @default(false)
  website                  String?
  zipCode                  String?
  deliveryPreparationHours Int                     @default(24)
  slots                    AppointmentSlot[]
  bookings                 Booking[]
  products                 Product[]
  restaurants              Restaurant[]
  reviews                  Review[]
  services                 Service[]
  categoryRequests         VendorCategoryRequest[]
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([deliveryPreparationHours])
  @@map("vendors")
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?      @db.VarChar(1000)
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
  restaurants Restaurant[]
  services    Service[]

  @@map("categories")
}

model VendorCategoryRequest {
  id          String                @id @default(cuid())
  vendorId    String
  name        String
  slug        String
  description String?               @db.VarChar(1000)
  image       String?
  status      CategoryRequestStatus @default(PENDING)
  adminNote   String?
  reviewedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  vendor      VendorProfile         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@index([slug])
  @@map("vendor_category_requests")
}

model Product {
  id                 String           @id @default(cuid())
  vendorId           String?
  categoryId         String
  title              String
  slug               String           @unique
  description        String?          @db.VarChar(1000)
  price              Decimal          @db.Decimal(10, 2)
  currency           String           @default("AED")
  stock              Int              @default(0)
  images             String[]
  status             ProductStatus    @default(DRAFT)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  aboutBrand         String?
  brandImage         String?
  exchangePolicy     String?
  refundPolicy       String?
  specifications     Json?
  specificationImage String?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  options            ProductOption[]
  variants           ProductVariant[]
  category           Category         @relation(fields: [categoryId], references: [id])
  vendor             VendorProfile?   @relation(fields: [vendorId], references: [id])
  reviews            Review[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("products")
}

model ServiceProvider {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String?               @db.VarChar(1000)
  logo        String?
  website     String?
  status      ServiceProviderStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  services    Service[]

  @@index([name])
  @@index([status])
  @@map("service_providers")
}

model Service {
  id                 String            @id @default(cuid())
  vendorId           String?
  categoryId         String
  title              String
  slug               String            @unique
  description        String?           @db.VarChar(1000)
  price              Decimal           @db.Decimal(10, 2)
  currency           String            @default("AED")
  duration           Int?
  images             String[]
  status             ServiceStatus     @default(DRAFT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  aboutBrand         String?
  brandImage         String?
  exchangePolicy     String?
  refundPolicy       String?
  specifications     Json?
  specificationImage String?
  serviceProviderId  String?
  slots              AppointmentSlot[]
  bookings           Booking[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  category           Category          @relation(fields: [categoryId], references: [id])
  serviceProvider    ServiceProvider?  @relation(fields: [serviceProviderId], references: [id])
  vendor             VendorProfile?    @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([serviceProviderId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("services")
}

model Restaurant {
  id                          String                    @id @default(cuid())
  vendorId                    String
  categoryId                  String?
  name                        String
  slug                        String                    @unique
  description                 String?                   @db.VarChar(1000)
  shortDescription            String?                   @db.VarChar(1000)
  phone                       String?
  email                       String?
  website                     String?
  logo                        String?
  coverImage                  String?
  images                      String[]
  cuisineTypes                String[]
  priceForTwo                 Decimal?                  @db.Decimal(10, 2)
  currency                    String                    @default("AED")
  address                     String?
  addressLine1                String?
  addressLine2                String?
  country                     String?
  state                       String?
  city                        String?
  area                        String?
  zipCode                     String?
  latitude                    Decimal?                  @db.Decimal(10, 7)
  longitude                   Decimal?                  @db.Decimal(10, 7)
  isTableReservationAvailable Boolean                   @default(true)
  status                      RestaurantStatus          @default(DRAFT)
  isFeatured                  Boolean                   @default(false)
  isPopular                   Boolean                   @default(false)
  approvedAt                  DateTime?
  rejectedReason              String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  allowGuestReservation       Boolean                   @default(false)
  allowSameDayReservation     Boolean                   @default(true)
  reservationAdvanceDays      Int                       @default(30)
  reservationAutoConfirm      Boolean                   @default(false)
  reservationBufferMinutes    Int                       @default(0)
  reservationCancellationNote String?
  reservationMaxGuests        Int?
  reservationMinGuests        Int                       @default(1)
  reservationNoticeMinutes    Int                       @default(60)
  reservationSlotMinutes      Int                       @default(60)
  reservationTerms            String?
  exchangePolicy              String?
  refundPolicy                String?
  specifications              Json?
  blockedSlots                RestaurantBlockedSlot[]
  menuItems                   RestaurantMenuItem[]
  operatingHours              RestaurantOperatingHour[]
  reservations                RestaurantReservation[]
  specialHours                RestaurantSpecialHour[]
  tables                      RestaurantTable[]
  category                    Category?                 @relation(fields: [categoryId], references: [id])
  vendor                      VendorProfile             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviews                     Review[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([city])
  @@index([area])
  @@index([isFeatured])
  @@index([isPopular])
  @@index([isTableReservationAvailable])
  @@map("restaurants")
}

model RestaurantMenuItem {
  id           String                  @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  description  String?                 @db.VarChar(1000)
  price        Decimal                 @db.Decimal(10, 2)
  currency     String                  @default("AED")
  image        String?
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  images       String[]                @default([])
  menuType     RestaurantMenuType      @default(REGULAR)
  validFrom    DateTime?               @db.Date
  validUntil   DateTime?               @db.Date
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations RestaurantReservation[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([isActive])
  @@index([menuType])
  @@index([validUntil])
  @@index([sortOrder])
  @@map("restaurant_menu_items")
}

model RestaurantOperatingHour {
  id                  String     @id @default(cuid())
  restaurantId        String
  dayOfWeek           Int
  openTime            String?
  closeTime           String?
  isClosed            Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastReservationTime String?
  note                String?
  slotMinutes         Int?
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@index([dayOfWeek])
  @@map("restaurant_operating_hours")
}

model RestaurantSpecialHour {
  id           String     @id @default(cuid())
  restaurantId String
  date         DateTime   @db.Date
  openTime     String?
  closeTime    String?
  isClosed     Boolean    @default(false)
  reason       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId])
  @@index([date])
  @@index([isClosed])
  @@map("restaurant_special_hours")
}

model RestaurantTable {
  id           String                  @id @default(cuid())
  restaurantId String
  tableNumber  String
  capacity     Int
  note         String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  isReservable Boolean                 @default(true)
  seatingArea  String?
  sortOrder    Int                     @default(0)
  status       RestaurantTableStatus   @default(ACTIVE)
  blockedSlots RestaurantBlockedSlot[]
  reservations RestaurantReservation[]
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([capacity])
  @@index([status])
  @@index([isReservable])
  @@map("restaurant_tables")
}

model RestaurantBlockedSlot {
  id           String           @id @default(cuid())
  restaurantId String
  tableId      String?
  date         DateTime         @db.Date
  startTime    String
  endTime      String
  reason       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        RestaurantTable? @relation(fields: [tableId], references: [id])

  @@index([restaurantId])
  @@index([tableId])
  @@index([date])
  @@index([startTime])
  @@map("restaurant_blocked_slots")
}

model RestaurantReservation {
  id               String                      @id @default(cuid())
  customerId       String?
  restaurantId     String
  tableId          String?
  reservationDate  DateTime                    @db.Date
  startTime        String
  endTime          String
  guests           Int
  amount           Decimal                     @default(0) @db.Decimal(10, 2)
  currency         String                      @default("AED")
  status           RestaurantReservationStatus @default(PENDING)
  customerNote     String?
  vendorNote       String?
  cancelReason     String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  adminNote        String?
  cancelledAt      DateTime?
  completedAt      DateTime?
  confirmedAt      DateTime?
  customerEmail    String?
  customerName     String?
  customerPhone    String?
  noShowAt         DateTime?
  paymentStatus    PaymentStatus               @default(PENDING)
  reservationCode  String                      @unique @default(cuid())
  slotMinutes      Int                         @default(60)
  source           RestaurantReservationSource @default(CUSTOMER)
  menuItemCurrency String?
  menuItemId       String?
  menuItemPrice    Decimal?                    @db.Decimal(10, 2)
  menuItemTitle    String?
  payment          Payment?
  customer         User?                       @relation(fields: [customerId], references: [id])
  menuItem         RestaurantMenuItem?         @relation(fields: [menuItemId], references: [id])
  restaurant       Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table            RestaurantTable?            @relation(fields: [tableId], references: [id])

  @@unique([restaurantId, tableId, reservationDate, startTime])
  @@index([customerId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([menuItemId])
  @@index([status])
  @@index([paymentStatus])
  @@index([reservationDate])
  @@index([startTime])
  @@map("restaurant_reservations")
}

model AppointmentSlot {
  id              String         @id @default(cuid())
  vendorId        String?
  serviceId       String
  date            DateTime
  startTime       String
  endTime         String
  capacity        Int            @default(1)
  bookedCount     Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  durationMinutes Int?
  note            String?
  service         Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vendor          VendorProfile? @relation(fields: [vendorId], references: [id])
  bookings        Booking[]

  @@unique([serviceId, date, startTime, endTime])
  @@index([vendorId])
  @@index([serviceId])
  @@index([date])
  @@index([isActive])
  @@map("appointment_slots")
}

model Booking {
  id              String          @id @default(cuid())
  customerId      String
  vendorId        String?
  serviceId       String
  slotId          String
  bookingDate     DateTime
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("AED")
  status          BookingStatus   @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cancelReason    String?
  customerNote    String?
  durationMinutes Int?
  endTime         String
  startTime       String
  vendorNote      String?
  customer        User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id])
  slot            AppointmentSlot @relation(fields: [slotId], references: [id])
  vendor          VendorProfile?  @relation(fields: [vendorId], references: [id])
  payment         Payment?

  @@index([customerId])
  @@index([vendorId])
  @@index([serviceId])
  @@index([slotId])
  @@index([status])
  @@index([bookingDate])
  @@map("bookings")
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String?
  serviceId String?
  quantity  Int             @default(1)
  price     Decimal         @db.Decimal(10, 2)
  currency  String          @default("AED")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  variantId String?
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id])
  service   Service?        @relation(fields: [serviceId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@index([serviceId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                          String              @id @default(cuid())
  customerId                  String
  subtotal                    Decimal             @db.Decimal(10, 2)
  shipping                    Decimal             @default(0) @db.Decimal(10, 2)
  tax                         Decimal             @default(0) @db.Decimal(10, 2)
  total                       Decimal             @db.Decimal(10, 2)
  currency                    String              @default("AED")
  status                      OrderStatus         @default(PENDING)
  paymentStatus               PaymentStatus       @default(PENDING)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  deliveryAddress             String?
  deliveryAddressLine1        String?
  deliveryAddressLine2        String?
  deliveryArea                String?
  deliveryCity                String?
  deliveryCountry             String?
  deliveryEmail               String?
  deliveryFullName            String?
  deliveryLatitude            Decimal?            @db.Decimal(10, 7)
  deliveryLongitude           Decimal?            @db.Decimal(10, 7)
  deliveryNote                String?
  deliveryPhone               String?
  deliveryState               String?
  deliveryZipCode             String?
  deliveryLeadTimeHours       Int                 @default(24)
  requestedDeliveryDate       DateTime?
  requestedDeliveryTimePeriod DeliveryTimePeriod?
  items                       OrderItem[]
  customer                    User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment                     Payment?

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([deliveryCity])
  @@index([deliveryArea])
  @@index([requestedDeliveryDate])
  @@index([requestedDeliveryTimePeriod])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String?
  title          String
  price          Decimal         @db.Decimal(10, 2)
  quantity       Int             @default(1)
  currency       String          @default("AED")
  serviceId      String?
  status         OrderStatus     @default(PENDING)
  vendorNote     String?
  variantId      String?
  variantImage   String?
  variantOptions Json?
  variantSku     String?
  variantTitle   String?
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  service        Service?        @relation(fields: [serviceId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@index([variantId])
  @@index([status])
  @@map("order_items")
}

model Payment {
  id                      String                 @id @default(cuid())
  orderId                 String?                @unique
  amount                  Decimal                @db.Decimal(10, 2)
  currency                String                 @default("AED")
  method                  PaymentMethod
  status                  PaymentStatus          @default(PENDING)
  transactionId           String?
  provider                String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  bookingId               String?                @unique
  restaurantReservationId String?                @unique
  checkoutData            Json?
  checkoutKey             String?                @unique
  customerId              String?
  failureReason           String?
  idempotencyKey          String?                @unique
  processedAt             DateTime?
  providerPaymentId       String?                @unique
  providerSessionData     Json?
  providerSessionId       String?                @unique
  providerStatus          String?
  purpose                 PaymentPurpose?
  webhookEvents           PaymentWebhookEvent[]
  booking                 Booking?               @relation(fields: [bookingId], references: [id])
  customer                User?                  @relation(fields: [customerId], references: [id])
  order                   Order?                 @relation(fields: [orderId], references: [id])
  restaurantReservation   RestaurantReservation? @relation(fields: [restaurantReservationId], references: [id])

  @@index([customerId])
  @@index([purpose])
  @@index([status])
  @@index([method])
  @@index([provider])
  @@index([providerStatus])
  @@index([orderId])
  @@index([bookingId])
  @@index([restaurantReservationId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  paymentId       String?
  provider        String
  eventId         String
  eventType       String
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payment         Payment?  @relation(fields: [paymentId], references: [id])

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([eventType])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

model Review {
  id           String         @id @default(cuid())
  customerId   String
  vendorId     String?
  productId    String?
  serviceId    String?
  rating       Int
  comment      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurantId String?
  customer     User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product?       @relation(fields: [productId], references: [id])
  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id])
  service      Service?       @relation(fields: [serviceId], references: [id])
  vendor       VendorProfile? @relation(fields: [vendorId], references: [id])

  @@index([customerId])
  @@index([vendorId])
  @@index([productId])
  @@index([serviceId])
  @@index([restaurantId])
  @@map("reviews")
}

model CurrencyRate {
  id             String   @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(12, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency])
  @@map("currency_rates")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  values    Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
  @@map("product_options")
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  title      String
  sku        String?
  options    Json
  price      Decimal     @db.Decimal(10, 2)
  currency   String      @default("AED")
  stock      Int         @default(0)
  image      String?
  isActive   Boolean     @default(true)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([isDefault])
  @@map("product_variants")
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ServiceProviderStatus {
  ACTIVE
  INACTIVE
}

