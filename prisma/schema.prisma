// Prisma schema for Multi-Vendor Shopping + Services + Table Reservation Marketplace

// IMPORTANT:
// Restaurant module is table-reservation only.
// Restaurant menu items are used as reservation packages/menu selections.
// They are not used for food ordering cart.
//
// Description and shortDescription fields that use PostgreSQL VARCHAR(1000)
// retain a 1,000-character database-level safety ceiling.
// Product, Service, and Restaurant content limits are business rules controlled
// by Admin settings and are independently enforced by frontend forms and API routes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------
// ENUMS
// --------------------

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ServiceProviderStatus {
  ACTIVE
  INACTIVE
}

enum RestaurantStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  INACTIVE
  REJECTED
  SUSPENDED
}

enum RestaurantTableStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RestaurantMenuType {
  REGULAR
  COMBO
}

enum RestaurantReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum RestaurantReservationSource {
  CUSTOMER
  VENDOR
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentPurpose {
  PRODUCT_ORDER
  SERVICE_BOOKING
  RESTAURANT_RESERVATION
}

enum PaymentMethod {
  CARD
  PAYPAL
  GOOGLE_PAY
  CASH_ON_DELIVERY
  WALLET
}

enum DeliveryTimePeriod {
  MORNING
  AFTERNOON
  EVENING
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_STATUS_UPDATED
  RESTAURANT_RESERVATION_CREATED
  RESTAURANT_RESERVATION_CONFIRMED
  RESTAURANT_RESERVATION_REJECTED
  RESTAURANT_RESERVATION_CANCELLED
  RESTAURANT_RESERVATION_COMPLETED
  RESTAURANT_RESERVATION_NO_SHOW
  RESTAURANT_APPROVED
  RESTAURANT_REJECTED
  PAYMENT_STATUS_UPDATED
  PAYMENT_PAID
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  ORDER_CREATED
  ORDER_STATUS_UPDATED
  VENDOR_APPROVED
  VENDOR_REJECTED
  SYSTEM
}

// --------------------
// USER
// --------------------

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  username        String?   @unique
  password        String
  phone           String?
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendorProfile           VendorProfile?
  cart                    Cart?
  orders                  Order[]
  bookings                Booking[]
  restaurantReservations  RestaurantReservation[]
  reviews                 Review[]
  notifications           Notification[]
  emailVerificationTokens EmailVerificationToken[]
  payments                Payment[]
  adminLoginOtp           AdminLoginOtp?

  @@index([role])
  @@index([emailVerifiedAt])
  @@map("users")
}

// --------------------
// EMAIL VERIFICATION TOKEN
// --------------------

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}


model AdminLoginOtp {
  id         String   @id @default(cuid())
  userId     String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_login_otps")
}

// --------------------
// VENDOR
// --------------------

model VendorProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  businessName String
  slug         String       @unique
  description  String?      @db.VarChar(1000)
  phone        String?
  address      String?
  city         String?
  country      String?
  status       VendorStatus @default(PENDING)

  // Product delivery preparation setting.
  // Checkout will use this vendor value for vendor-owned products.
  // Admin-owned products should use the global Setting key: defaultProductDeliveryPreparationHours.
  deliveryPreparationHours Int @default(24)

  categoryRequests VendorCategoryRequest[]
  commissionRate   Decimal                 @default(0) @db.Decimal(5, 2)

  brandName              String?
  companyName            String?
  branchName             String?
  website                String?
  mobileCountryCode      String?
  residentialPhone       String?
  residentialCountryCode String?
  state                  String?
  addressLine1           String?
  addressLine2           String?
  zipCode                String?
  licenseFile            String?
  licenseExpiry          DateTime?
  termsAccepted          Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  services    Service[]
  restaurants Restaurant[]
  slots       AppointmentSlot[]
  bookings    Booking[]
  reviews     Review[]

  @@index([status])
  @@index([deliveryPreparationHours])
  @@map("vendors")
}

// --------------------
// CATEGORY
// --------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.VarChar(1000)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  services    Service[]
  restaurants Restaurant[]

  @@map("categories")
}

model VendorCategoryRequest {
  id          String                @id @default(cuid())
  vendorId    String
  name        String
  slug        String
  description String?               @db.VarChar(1000)
  image       String?
  status      CategoryRequestStatus @default(PENDING)
  adminNote   String?
  reviewedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@index([slug])
  @@map("vendor_category_requests")
}

// --------------------
// PRODUCT
// --------------------

model Product {
  id                 String           @id @default(cuid())
  vendorId           String?
  categoryId         String
  title              String
  slug               String           @unique
  description        String?          @db.VarChar(1000)
  options            ProductOption[]
  variants           ProductVariant[]
  specifications     Json?
  specificationImage String?
  exchangePolicy     String?
  refundPolicy       String?
  aboutBrand         String?
  brandImage         String?
  price              Decimal          @db.Decimal(10, 2)
  currency           String           @default("AED")
  stock              Int              @default(0)
  images             String[]
  status             ProductStatus    @default(DRAFT)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  vendor     VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category   Category       @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("products")
}

// --------------------
// SERVICE PROVIDER
// --------------------
// Admin manages this master list.
// Vendors and administrators select one provider when creating or editing a service.

model ServiceProvider {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String?               @db.VarChar(1000)
  logo        String?
  website     String?
  status      ServiceProviderStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  services Service[]

  @@index([name])
  @@index([status])
  @@map("service_providers")
}

// --------------------
// SERVICE / EXPERIENCE
// --------------------

model Service {
  id                 String        @id @default(cuid())
  vendorId           String?
  serviceProviderId  String?
  categoryId         String
  title              String
  slug               String        @unique
  description        String?       @db.VarChar(1000)
  specifications     Json?
  specificationImage String?
  exchangePolicy     String?
  refundPolicy       String?
  aboutBrand         String?
  brandImage         String?
  price              Decimal       @db.Decimal(10, 2)
  currency           String        @default("AED")
  duration           Int?
  images             String[]
  status             ServiceStatus @default(DRAFT)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vendor          VendorProfile?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  serviceProvider ServiceProvider?  @relation(fields: [serviceProviderId], references: [id], onDelete: SetNull)
  category        Category          @relation(fields: [categoryId], references: [id])
  slots           AppointmentSlot[]
  bookings        Booking[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]

  @@index([vendorId])
  @@index([serviceProviderId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("services")
}

// --------------------
// RESTAURANT - TABLE RESERVATION ONLY
// --------------------

model Restaurant {
  id               String  @id @default(cuid())
  vendorId         String
  categoryId       String?
  name             String
  slug             String  @unique
  description      String? @db.VarChar(1000)
  shortDescription String? @db.VarChar(1000)
  specifications     Json?
  exchangePolicy     String?
  refundPolicy       String?

  phone   String?
  email   String?
  website String?

  logo       String?
  coverImage String?
  images     String[]

  cuisineTypes String[]

  priceForTwo Decimal? @db.Decimal(10, 2)
  currency    String   @default("AED")

  address      String?
  addressLine1 String?
  addressLine2 String?
  country      String?
  state        String?
  city         String?
  area         String?
  zipCode      String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  isTableReservationAvailable Boolean @default(true)

  // Reservation calculation settings
  // Slots are calculated from opening time, closing time, slot duration, buffer, selected date, and active tables.
  reservationSlotMinutes      Int     @default(60)
  reservationBufferMinutes    Int     @default(0)
  reservationAdvanceDays      Int     @default(30)
  reservationNoticeMinutes    Int     @default(60)
  reservationMinGuests        Int     @default(1)
  reservationMaxGuests        Int?
  reservationAutoConfirm      Boolean @default(false)
  allowSameDayReservation     Boolean @default(true)
  allowGuestReservation       Boolean @default(false)
  reservationTerms            String?
  reservationCancellationNote String?

  status         RestaurantStatus @default(DRAFT)
  isFeatured     Boolean          @default(false)
  isPopular      Boolean          @default(false)
  approvedAt     DateTime?
  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor         VendorProfile             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category       Category?                 @relation(fields: [categoryId], references: [id])
  operatingHours RestaurantOperatingHour[]
  specialHours   RestaurantSpecialHour[]
  tables         RestaurantTable[]
  menuItems      RestaurantMenuItem[]
  reservations   RestaurantReservation[]
  blockedSlots   RestaurantBlockedSlot[]
  reviews        Review[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([city])
  @@index([area])
  @@index([isFeatured])
  @@index([isPopular])
  @@index([isTableReservationAvailable])
  @@map("restaurants")
}

// --------------------
// RESTAURANT MENU ITEM / RESERVATION PACKAGE
// Customer selects one menu/package during table reservation.
// Checkout price is calculated from this selected menu/package.
// This is not food ordering.
// --------------------

model RestaurantMenuItem {
  id           String             @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  description  String?            @db.VarChar(1000)
  menuType     RestaurantMenuType @default(REGULAR)
  validFrom    DateTime?          @db.Date
  validUntil   DateTime?          @db.Date
  price        Decimal            @db.Decimal(10, 2)
  currency     String             @default("AED")
  image        String?
  images       String[]           @default([])
  isActive     Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations RestaurantReservation[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([isActive])
  @@index([menuType])
  @@index([validUntil])
  @@index([sortOrder])
  @@map("restaurant_menu_items")
}

// --------------------
// RESTAURANT OPERATING HOUR
// dayOfWeek: 0 = Sunday, 1 = Monday, ... 6 = Saturday
// openTime/closeTime format: HH:mm, for example 10:00, 22:30
// --------------------

model RestaurantOperatingHour {
  id           String  @id @default(cuid())
  restaurantId String
  dayOfWeek    Int
  openTime     String?
  closeTime    String?
  isClosed     Boolean @default(false)

  // Optional daily override. If null, restaurant.reservationSlotMinutes will be used.
  slotMinutes         Int?
  lastReservationTime String?
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@index([dayOfWeek])
  @@map("restaurant_operating_hours")
}

// --------------------
// RESTAURANT SPECIAL HOUR / DATE EXCEPTION
// Use this for holidays, special closed dates, or custom opening/closing time on a selected date.
// date is calendar-only.
// --------------------

model RestaurantSpecialHour {
  id           String   @id @default(cuid())
  restaurantId String
  date         DateTime @db.Date
  openTime     String?
  closeTime    String?
  isClosed     Boolean  @default(false)
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId])
  @@index([date])
  @@index([isClosed])
  @@map("restaurant_special_hours")
}

// --------------------
// RESTAURANT TABLE
// One row = one physical table.
// Slot availability is calculated from active/reservable tables minus confirmed/pending reservations and blocked slots.
// --------------------

model RestaurantTable {
  id           String                @id @default(cuid())
  restaurantId String
  tableNumber  String
  capacity     Int
  seatingArea  String?
  sortOrder    Int                   @default(0)
  isReservable Boolean               @default(true)
  status       RestaurantTableStatus @default(ACTIVE)
  note         String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations RestaurantReservation[]
  blockedSlots RestaurantBlockedSlot[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([capacity])
  @@index([status])
  @@index([isReservable])
  @@map("restaurant_tables")
}

// --------------------
// RESTAURANT BLOCKED SLOT
// Vendor/Admin can block a full restaurant or a single table for maintenance/private events.
// date is calendar-only. startTime/endTime format: HH:mm.
// --------------------

model RestaurantBlockedSlot {
  id           String   @id @default(cuid())
  restaurantId String
  tableId      String?
  date         DateTime @db.Date
  startTime    String
  endTime      String
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([tableId])
  @@index([date])
  @@index([startTime])
  @@map("restaurant_blocked_slots")
}

// --------------------
// RESTAURANT RESERVATION
// date is calendar-only. startTime/endTime format: HH:mm.
// tableId can be assigned automatically or later by vendor/admin.
// menuItemId is the selected reservation menu/package.
// --------------------

model RestaurantReservation {
  id              String  @id @default(cuid())
  reservationCode String  @unique @default(cuid())
  customerId      String?
  restaurantId    String
  tableId         String?
  menuItemId      String?

  menuItemTitle    String?
  menuItemPrice    Decimal? @db.Decimal(10, 2)
  menuItemCurrency String?

  reservationDate DateTime @db.Date
  startTime       String
  endTime         String
  slotMinutes     Int      @default(60)
  guests          Int
  amount          Decimal  @default(0) @db.Decimal(10, 2)
  currency        String   @default("AED")

  status        RestaurantReservationStatus @default(PENDING)
  source        RestaurantReservationSource @default(CUSTOMER)
  paymentStatus PaymentStatus               @default(PENDING)

  customerName  String?
  customerEmail String?
  customerPhone String?
  customerNote  String?
  vendorNote    String?
  adminNote     String?
  cancelReason  String?

  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  noShowAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   User?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  menuItem   RestaurantMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  payment    Payment?

  @@unique([restaurantId, tableId, reservationDate, startTime])
  @@index([customerId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([menuItemId])
  @@index([status])
  @@index([paymentStatus])
  @@index([reservationDate])
  @@index([startTime])
  @@map("restaurant_reservations")
}

// --------------------
// APPOINTMENT SLOT
// --------------------

model AppointmentSlot {
  id              String   @id @default(cuid())
  vendorId        String?
  serviceId       String
  date            DateTime
  startTime       String
  endTime         String
  durationMinutes Int?
  capacity        Int      @default(1)
  bookedCount     Int      @default(0)
  isActive        Boolean  @default(true)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  service  Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([serviceId, date, startTime, endTime])
  @@index([vendorId])
  @@index([serviceId])
  @@index([date])
  @@index([isActive])
  @@map("appointment_slots")
}

// --------------------
// BOOKING
// --------------------

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  vendorId        String?
  serviceId       String
  slotId          String
  bookingDate     DateTime
  startTime       String
  endTime         String
  durationMinutes Int?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("AED")
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  customerNote    String?
  vendorNote      String?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   VendorProfile?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  service  Service         @relation(fields: [serviceId], references: [id])
  slot     AppointmentSlot @relation(fields: [slotId], references: [id])
  payment  Payment?

  @@index([customerId])
  @@index([vendorId])
  @@index([serviceId])
  @@index([slotId])
  @@index([status])
  @@index([bookingDate])
  @@map("bookings")
}

// --------------------
// CART
// Restaurant items are removed because client does not want food order system.
// Cart is now only for products/services.
// --------------------

model Cart {
  id         String   @id @default(cuid())
  customerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  serviceId String?
  variantId String?
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("AED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  service Service?        @relation(fields: [serviceId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@index([serviceId])
  @@index([variantId])
  @@map("cart_items")
}

// --------------------
// ORDER
// Restaurant/menu item order fields are removed.
// Orders are now for products/services only.
// --------------------

model Order {
  id            String        @id @default(cuid())
  customerId    String
  subtotal      Decimal       @db.Decimal(10, 2)
  shipping      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @default("AED")
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  deliveryFullName     String?
  deliveryPhone        String?
  deliveryEmail        String?
  deliveryAddress      String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryCountry      String?
  deliveryState        String?
  deliveryCity         String?
  deliveryArea         String?
  deliveryZipCode      String?
  deliveryLatitude     Decimal? @db.Decimal(10, 7)
  deliveryLongitude    Decimal? @db.Decimal(10, 7)
  deliveryNote         String?

  // Optional delivery schedule selected by the customer.
  // These fields are used only when the customer enables preferred delivery scheduling during checkout.
  requestedDeliveryDate       DateTime?
  requestedDeliveryTimePeriod DeliveryTimePeriod?

  // Snapshot of the preparation time used when this order was placed.
  // This keeps old orders stable even if admin/vendor settings are changed later.
  deliveryLeadTimeHours Int @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payment  Payment?

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([deliveryCity])
  @@index([deliveryArea])
  @@index([requestedDeliveryDate])
  @@index([requestedDeliveryTimePeriod])
  @@map("orders")
}

model OrderItem {
  id         String      @id @default(cuid())
  orderId    String
  productId  String?
  serviceId  String?
  variantId  String?
  title      String
  price      Decimal     @db.Decimal(10, 2)
  quantity   Int         @default(1)
  currency   String      @default("AED")
  status     OrderStatus @default(PENDING)
  vendorNote String?

  variantTitle   String?
  variantSku     String?
  variantOptions Json?
  variantImage   String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  service Service?        @relation(fields: [serviceId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@index([variantId])
  @@index([status])
  @@map("order_items")
}

// --------------------
// PAYMENT
// Payment can belong to an order, service booking, or restaurant reservation.
// --------------------

model Payment {
  id                      String          @id @default(cuid())
  customerId              String?
  orderId                 String?         @unique
  bookingId               String?         @unique
  restaurantReservationId String?         @unique
  purpose                 PaymentPurpose?
  amount                  Decimal         @db.Decimal(10, 2)
  currency                String          @default("AED")
  method                  PaymentMethod
  status                  PaymentStatus   @default(PENDING)
  idempotencyKey          String?         @unique
  checkoutKey             String?         @unique
  provider                String?
  providerSessionId       String?         @unique
  providerSessionData     Json?
  providerPaymentId       String?         @unique
  providerStatus          String?
  transactionId           String?
  checkoutData            Json?
  processedAt             DateTime?
  failureReason           String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  customer              User?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  booking               Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  restaurantReservation RestaurantReservation? @relation(fields: [restaurantReservationId], references: [id], onDelete: SetNull)
  webhookEvents          PaymentWebhookEvent[]

  @@index([customerId])
  @@index([purpose])
  @@index([status])
  @@index([method])
  @@index([provider])
  @@index([providerStatus])
  @@index([orderId])
  @@index([bookingId])
  @@index([restaurantReservationId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  paymentId       String?
  provider        String
  eventId         String
  eventType       String
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([eventType])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

// --------------------
// REVIEW
// Restaurant menu item review is removed because restaurant food ordering is removed.
// --------------------

model Review {
  id           String   @id @default(cuid())
  customerId   String
  vendorId     String?
  productId    String?
  serviceId    String?
  restaurantId String?
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer   User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor     VendorProfile? @relation(fields: [vendorId], references: [id])
  product    Product?       @relation(fields: [productId], references: [id])
  service    Service?       @relation(fields: [serviceId], references: [id])
  restaurant Restaurant?    @relation(fields: [restaurantId], references: [id])

  @@index([customerId])
  @@index([vendorId])
  @@index([productId])
  @@index([serviceId])
  @@index([restaurantId])
  @@map("reviews")
}

// --------------------
// CURRENCY RATE
// --------------------

model CurrencyRate {
  id             String   @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(12, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency])
  @@map("currency_rates")
}

// --------------------
// SETTINGS
// --------------------

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  // Recommended global keys:
  // defaultProductDeliveryPreparationHours = "24"
  // maxImageUploadSizeMb = "5"
  //
  // maxImageUploadSizeMb is controlled by the administrator.
  // The upload API must validate this value and use 5 MB as a safe fallback.
  // Recommended accepted range: 1 MB to 25 MB.
  //
  // Vendor-specific product preparation time is stored in:
  // VendorProfile.deliveryPreparationHours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// --------------------
// NOTIFICATION
// --------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// --------------------
// Variations Model
// --------------------

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  values    Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
  @@map("product_options")
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  title   String
  sku     String?
  options Json

  price     Decimal @db.Decimal(10, 2)
  currency  String  @default("AED")
  stock     Int     @default(0)
  image     String?
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([isActive])
  @@index([isDefault])
  @@map("product_variants")
}
